<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup / device transfer (Android 12+). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="backup_state.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="backup_state.xml"/>
    </device-transfer>
</data-extraction-rules>
